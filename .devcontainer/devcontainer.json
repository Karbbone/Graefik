{
  "name": "Graefik",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/go:1": { "version": "1.26" }
  },
  "mounts": [
    "source=graefik-dev-node-modules,target=${containerWorkspaceFolder}/node_modules,type=volume",
    "source=graefik-dev-web-node-modules,target=${containerWorkspaceFolder}/apps/web/node_modules,type=volume"
  ],
  "containerEnv": {
    "APP_ENV": "development",
    "PORT": "8080",
    "CORS_ORIGINS": "http://localhost:5173",
    "DB_PATH": "/workspaces/${localWorkspaceFolderBasename}/apps/api/tmp/graefik.db",
    "TURBO_UI": "stream"
  },
  "forwardPorts": [5173, 8080],
  "portsAttributes": {
    "5173": {
      "label": "Frontend (Vite)",
      "onAutoForward": "openBrowser"
    },
    "8080": {
      "label": "API (Go)"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postAttachCommand": "bash .devcontainer/start-dev.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "biomejs.biome",
        "bradlc.vscode-tailwindcss",
        "ms-azuretools.vscode-docker",
        "vitest.explorer"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "biomejs.biome",
        "[go]": { "editor.defaultFormatter": "golang.go" },
        "go.lintTool": "golangci-lint",
        "go.lintFlags": ["run"],
        "eslint.workingDirectories": [{ "pattern": "apps/web" }]
      }
    }
  },
  "remoteUser": "vscode"
}
