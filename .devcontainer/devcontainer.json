{
  "name": "Graefik",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/go:1": { "version": "1.26" }
  },
  "containerEnv": {
    "APP_ENV": "development",
    "DB_PATH": "/workspaces/Graefik/apps/api/tmp/graefik.db"
  },
  "forwardPorts": [5173, 8080],
  "portsAttributes": {
    "5173": { "label": "Frontend (Vite)" },
    "8080": { "label": "API (Go)" }
  },
  "postCreateCommand": "bun install && go -C apps/api mod download && (go install github.com/air-verse/air@v1.65.2 || true) && (curl -sSfL https://golangci-lint.run/install.sh | sh -s -- -b \"$(go env GOPATH)/bin\" v2.12.2 || true)",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "biomejs.biome",
        "bradlc.vscode-tailwindcss",
        "ms-azuretools.vscode-docker",
        "vitest.explorer"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "biomejs.biome",
        "[go]": { "editor.defaultFormatter": "golang.go" },
        "go.lintTool": "golangci-lint",
        "go.lintFlags": ["run"],
        "eslint.workingDirectories": [{ "pattern": "apps/web" }]
      }
    }
  },
  "remoteUser": "vscode"
}
