# --- Ports hotes (docker-compose) ---
# Changer si les ports sont deja pris sur la machine.
API_PORT=8080
WEB_PORT=5173

# --- API (Go / Echo) ---
APP_ENV=development

# --- Web (Vite / React) ---
# URL de l'API exposee au navigateur (utilisee par le proxy Vite en dev)
VITE_API_URL=http://localhost:8080
